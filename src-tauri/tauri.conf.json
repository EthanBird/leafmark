{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LeafMark",
  "version": "0.3.1",
  "identifier": "com.leafmark.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob: https: http:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'",
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    },
    "windows": [
      {
        "label": "main",
        "title": "LeafMark",
        "width": 1280,
        "height": 820,
        "minWidth": 780,
        "minHeight": 540,
        "resizable": true,
        "maximizable": true,
        "minimizable": true,
        "closable": true,
        "decorations": true,
        "transparent": false,
        "center": true,
        "backgroundColor": "#f2f3ef"
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "LeafMark（一叶），高性能本地 Markdown 工作区",
    "longDescription": "LeafMark（一叶）使用 Rust 高性能渲染 Markdown，支持 Mermaid 图表、KaTeX 数学公式与实时编辑。",
    "fileAssociations": [
      {
        "ext": ["md", "markdown"],
        "name": "Markdown 文档",
        "description": "Markdown 文档",
        "mimeType": "text/markdown",
        "role": "Editor",
        "androidIntentActionFilters": ["view", "send", "sendMultiple"]
      }
    ]
  }
}
