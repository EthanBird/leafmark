{
  "name": "leafmark",
  "version": "0.7.3",
  "description": "LeafMark（一叶）— 高性能、轻量、本地优先的 Markdown 阅读与写作应用",
  "private": true,
  "type": "module",
  "scripts": {
    "generate:katex-css": "node scripts/generate-katex-css.mjs",
    "predev": "npm run generate:katex-css",
    "dev": "vite",
    "prebuild": "npm run generate:katex-css",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "pretest": "npm run generate:katex-css",
    "test": "vitest run",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-http": "^2.5.9",
    "@tauri-apps/plugin-opener": "^2.5.0",
    "dompurify": "^3.4.12",
    "fflate": "^0.8.2",
    "html-to-image": "^1.11.13",
    "katex": "^0.16.22",
    "lucide-react": "^0.468.0",
    "marked": "^17.0.1",
    "mathjax-full": "^3.2.2",
    "mermaid": "^11.12.2",
    "pdfmake": "^0.2.20",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/katex": "^0.16.7",
    "@types/pdfmake": "^0.2.12",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.1",
    "jsdom": "^27.2.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.4",
    "vitest": "^4.0.15"
  }
}
